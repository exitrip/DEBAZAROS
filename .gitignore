.vscode/
.vscode-ctags

# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

#Vivado
!Vivado/
Vivado/*
!Vivado/Vivado.srcs/
!Vivado/IP*/
!Vivado/matlab/
!Vivado/Vivado.xpr

#Qt5 build
build-*/


# Tcl-flow Vivado builds (hw/build.tcl)
/build/

# Vivado batch/GUI run files in the repo root (vivado.log, vivado_1234.backup.jou, ...)
/vivado*.log
/vivado*.jou
/vivado_pid*.str
/vivado_pid*.zip
/.Xil/
# Vivado PS7 summary (NA/ps7_summary.html) when Vivado runs from the repo root
/NA/
