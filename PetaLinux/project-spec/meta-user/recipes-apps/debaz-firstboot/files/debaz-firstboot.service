# debaz-firstboot.service (2026-10-28): per-card setup (debaz-firstboot.sh):
# the data + exFAT media partitions in the free space of a new card, fstab,
# the media folders /media/debaz/{img,movies,audio}, then the MAC from the
# card's CID (debaz-mac.sh --firstboot: one reboot). Every step checks
# first, so later boots do nothing. Before the network, so the DHCP request
# after the reboot has the new MAC.
[Unit]
Description=DEBAZAROS first boot: media partition, media folders, MAC, hostname
DefaultDependencies=no
RequiresMountsFor=/boot
After=local-fs.target
Before=network-pre.target systemd-networkd.service networking.service
Wants=network-pre.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/debaz-firstboot.sh
TimeoutStartSec=300
StandardOutput=journal+console

[Install]
WantedBy=sysinit.target
