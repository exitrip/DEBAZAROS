/include/ "system-conf.dtsi"
/*
 * DEBAZAROS base device tree (2026-10-25). The ONLY copy: the old one in the
 * repo root was removed.
 *
 * - No PL nodes: project-spec/configs/config sets CONFIG_SUBSYSTEM_REMOVE_PL_DTB.
 *   Generated PL nodes bound real drivers (xilinx-vdma on the display VDMAs,
 *   xilinx-vtc) and stale ones pointed at blocks that no bitstream has.
 *   debazd and hdmi2 own the PL through /dev/mem. A variant can add UIO nodes
 *   with an overlay: fpgautil -b <variant>.bit.bin -o <variant>.dtbo
 *   (ROADMAP.md section 8).
 * - Every value below runs on the bench board (PetaLinux/dtb/system-96M.dtb,
 *   verified 2026-10-24).
 */
/ {
	chosen {
		/* cma=256M dropped: Linux has about 150 MB, the kernel already
		 * refused it (CmaTotal 0) and nothing uses CMA. */
		bootargs = "earlycon console=ttyPS0,115200 clk_ignore_unused root=/dev/mmcblk0p2 rw rootwait uio_pdrv_genirq.of_id=generic-uio";
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
		/* Video frame slots: 12 x 0x7E9000 (1920x1080x4) from 0x0800_0000
		 * (sw/lib/dz_hw.h). 96 MB, NOT 128 MB: a region up to the top of RAM
		 * overlaps the DTB that U-Boot places there, and the kernel then
		 * drops the whole reservation (PetaLinux/dtb/README.md). */
		hdmi_fb_reserved_region@8000000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x08000000 0x06000000>;
		};
	};

	/* /dev/fb0 for ffmpeg -f fbdev. simplefb allows only ONE instance
	 * (CLAUDE.md "Two independent framebuffers"). 1280x2160 = 3 x 720 lines
	 * from slot 0; display 0 shows the top 720 lines. */
	framebuffer0@8000000 {
		compatible = "simple-framebuffer";
		reg = <0x08000000 (1280 * 2160 * 4)>;
		width = <1280>;
		height = <2160>;
		stride = <(1280 * 4)>;
		format = "a8r8g8b8";
		status = "okay";
	};

	/* Target region for bitstream + overlay loads (fpgautil). PL-DTB removal
	 * also removes the generated one. devcfg = the Zynq FPGA manager. */
	fpga-full {
		compatible = "fpga-region";
		fpga-mgr = <&devcfg>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
	};
};

/* Soldered NAND (128 MB, PS NAND controller on MIO 0, 2-14; enabled in the
 * PS7 setup). It holds the board's first life as a miner control card. Without
 * this node: "pl353-smc: no matching children", empty /proc/mtd. One MTD
 * device, no partitions. READ IT ONLY: nanddump, or mount with -o ro; a
 * read-write JFFS2/UBIFS mount writes to the chip. */
&smcc {
	status = "okay";
};

&nfc0 {
	status = "okay";
	nand@0 {
		reg = <0>;
		nand-bus-width = <8>;
	};
};
