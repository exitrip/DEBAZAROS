+    // whole words only (2026-10-29): a byte or halfword store changes nothing
+    // (at the end: the reference takes these writes as full words)
+    wr(ra(4, 2), 32'h1234_5678);
+    dstrb = 4'b0010; wr(ra(4, 2), 32'h0000_AB00);
+    dstrb = 4'b1100; wr(ra(4, 2), 32'hCDEF_0000);
+    dstrb = 4'hf;
+    rd(ra(4, 2), v);
+    if (v !== 32'h1234_5678) fail("byte / halfword store ignored"); else $display("ok   byte / halfword store ignored");
