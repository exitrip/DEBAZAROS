diff --git a/ip/dvi2rgb/src/TMDS_Clocking.vhd b/ip/dvi2rgb/src/TMDS_Clocking.vhd
index 66a8541..59f1b64 100644
--- a/ip/dvi2rgb/src/TMDS_Clocking.vhd
+++ b/ip/dvi2rgb/src/TMDS_Clocking.vhd
@@ -191,6 +191,9 @@ DVI_ClkGenerator: MMCME2_ADV
       CLKOUT0_PHASE        => 0.000,
       CLKOUT0_DUTY_CYCLE   => 0.500,
       CLKOUT0_USE_FINE_PS  => FALSE,
+      CLKOUT1_DIVIDE       => kClkRange * 5,
+      CLKOUT1_PHASE        => 0.000,
+      CLKOUT1_DUTY_CYCLE   => 0.500,
       CLKIN1_PERIOD        => real(kClkRange) * 6.0,
       REF_JITTER1          => 0.010)
    port map
@@ -200,7 +203,7 @@ DVI_ClkGenerator: MMCME2_ADV
       CLKFBOUTB           => clkfboutb_unused,
       CLKOUT0             => CLK_OUT_5x_hdmi_clk,
       CLKOUT0B            => clkout0b_unused,
-      CLKOUT1             => clkout1_unused,
+      CLKOUT1             => CLK_OUT_1x_hdmi_clk,
       CLKOUT1B            => clkout1b_unused,
       CLKOUT2             => clkout2_unused,
       CLKOUT2B            => clkout2b_unused,
@@ -236,23 +239,29 @@ DVI_ClkGenerator: MMCME2_ADV
       RST                 => rMMCM_Reset_q(0));
 
 -- 5x fast serial clock
-SerialClkBuffer: BUFIO
+SerialClkBuffer: BUFG
    port map (
       O => SerialClk, -- 1-bit output: Clock output (connect to I/O clock loads).
       I => CLK_OUT_5x_hdmi_clk  -- 1-bit input: Clock input (connect to an IBUF or BUFMR).
    );
 -- 1x slow parallel clock
-PixelClkBuffer: BUFR
-   generic map (
-      BUFR_DIVIDE => "5",   -- Values: "BYPASS, 1, 2, 3, 4, 5, 6, 7, 8" 
-      SIM_DEVICE => "7SERIES"  -- Must be set to "7SERIES" 
-   )
+PixelClkBuffer: BUFG
    port map (
-      O => PixelClk,     -- 1-bit output: Clock output port
-      CE => '1',   -- 1-bit input: Active high, clock enable (Divided modes only)
-      CLR => rBUFR_Rst, -- 1-bit input: Active high, asynchronous clear (Divided modes only)        
-      I => CLK_OUT_5x_hdmi_clk      -- 1-bit input: Clock buffer input driven by an IBUF, MMCM or local interconnect
-   );     
+      I => CLK_OUT_1x_hdmi_clk,
+      O => PixelClk
+   );
+
+-- PixelClkBuffer: BUFR
+--    generic map (
+--       BUFR_DIVIDE => "5",   -- Values: "BYPASS, 1, 2, 3, 4, 5, 6, 7, 8" 
+--       SIM_DEVICE => "7SERIES"  -- Must be set to "7SERIES" 
+--    )
+--    port map (
+--       O => PixelClk,     -- 1-bit output: Clock output port
+--       CE => '1',   -- 1-bit input: Active high, clock enable (Divided modes only)
+--       CLR => rBUFR_Rst, -- 1-bit input: Active high, asynchronous clear (Divided modes only)        
+--       I => CLK_OUT_5x_hdmi_clk      -- 1-bit input: Clock buffer input driven by an IBUF, MMCM or local interconnect
+--    );     
 rBUFR_Rst <= rMMCM_LckdRisingFlag; --pulse CLR on BUFR once the clock returns
 
 MMCM_Reset: process(rLockLostRst, RefClk)
diff --git a/ip/dvi2rgb/src/TMDS_Decoder.vhd b/ip/dvi2rgb/src/TMDS_Decoder.vhd
index 47f50b3..af6500b 100644
--- a/ip/dvi2rgb/src/TMDS_Decoder.vhd
+++ b/ip/dvi2rgb/src/TMDS_Decoder.vhd
@@ -80,6 +80,10 @@ entity TMDS_Decoder is
       pC0 : out std_logic;
       pC1 : out std_logic;
       pVde : out std_logic;
+      -- HDMI (DEBAZAROS, 2026-10-26): the bonded 10-bit symbol, same timing as
+      -- the outputs above (control token 0 while not aligned); data islands and
+      -- guard bands decode as "data" above, hdmi_rx tells them apart
+      pDataRaw : out std_logic_vector(9 downto 0);
       
       -- Channel bonding (three data channels in total)
       pOtherChVld : in std_logic_vector(1 downto 0);
@@ -261,6 +265,7 @@ begin
    if Rising_Edge(PixelClk) then
       if (pMeRdy_int = '1' and pOtherChRdy = "11") then
          pDataIn <= x"00"; --added for VGA-compatibility (blank pixel needed during blanking)
+         pDataRaw <= pDataInBnd;
          
          case (pDataInBnd) is
             --Control tokens decode straight to C0, C1 values
@@ -297,6 +302,7 @@ begin
          pC1 <= '0';
          pVde <= '0';
          pDataIn <= x"00";
+         pDataRaw <= kCtlTkn0;
       end if;
    end if;
 end process;
