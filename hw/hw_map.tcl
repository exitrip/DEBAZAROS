# hw_map.tcl - write hw_map.h (PS-visible address map) from the open block design.
#
# Used by hw/build.tcl. Also usable by hand in the GUI Tcl console, with the
# project and its BD open (for example after an Address Editor change):
#
#   source <repo>/hw/hw_map.tcl
#   write_hw_map <repo>/build/<variant>/hw_map.h <variant>
#
# Each entry is named from the subordinate's full cell path
# (/HDMI_2/axi_vdma_0/S_AXI_LITE/Reg -> HW_HDMI_2_AXI_VDMA_0_BASE), because
# segment names alone are ambiguous when hierarchies reuse instance names.

proc write_hw_map {path variant} {
    set space [get_bd_addr_spaces -quiet */processing_system7_0/Data]
    if {$space eq ""} { error "no open BD with processing_system7_0/Data" }
    set segs {}
    foreach seg [get_bd_addr_segs -of_objects $space] {
        if {[get_property OFFSET $seg] ne ""} { lappend segs $seg }
    }
    set segs [lsort -command {apply {{a b} {
        expr {[get_property OFFSET $a] - [get_property OFFSET $b]}}}} $segs]

    set fh [open $path w]
    puts $fh "/* hw_map.h - GENERATED by hw/hw_map.tcl for variant $variant. Do not edit. */"
    puts $fh "#ifndef HW_MAP_H\n#define HW_MAP_H\n"
    puts $fh "#define HW_VARIANT \"$variant\"\n"
    foreach seg $segs {
        set off  [get_property OFFSET $seg]
        set rng  [get_property RANGE $seg]
        # The subordinate segment's PATH property is empty; its object name is the path.
        set sub  "[get_bd_addr_segs -of_objects $seg]"
        set cell [lrange [split [string trimleft $sub /] /] 0 end-2]
        set name [string toupper [regsub -all {[^A-Za-z0-9]+} [join $cell _] _]]
        puts $fh [format "#define HW_%-46s 0x%08X  /* range 0x%X, %s */" \
            ${name}_BASE $off $rng $sub]
    }
    puts $fh "\n#endif"
    close $fh
    puts "INFO: wrote $path"
}
